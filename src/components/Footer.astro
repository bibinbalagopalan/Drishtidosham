---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer
  class="bg-stone-950 text-stone-400 pt-24 pb-8 antialiased selection:bg-white selection:text-stone-950"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Top Section: 3-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8 mb-20">
      <!-- Column 1: Brand & Organizer (Takes up more space) -->
      <div class="md:col-span-5 md:pr-12">
        <h3
          class="text-3xl font-black text-white tracking-tighter uppercase mb-1"
        >
          Drishti<span class="text-stone-600">Dosham</span>
        </h3>
        <p class="text-xl font-serif italic text-stone-300 mb-6">
          Malayalam Short Film Festival
        </p>
        <p class="text-sm leading-relaxed text-stone-500 max-w-md">
          A joint initiative to promote regional cinematic storytelling, proudly
          organized by the Pazhassiraja Smaraka Granthalayam and the
          Mananthavady Municipality.
        </p>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="md:col-span-3">
        <h4
          class="text-[10px] font-bold text-white uppercase tracking-[0.3em] mb-8"
        >
          Navigation
        </h4>
        <ul class="space-y-4 text-sm font-medium">
          <li>
            <a
              href="/about"
              class="text-stone-400 hover:text-white transition-colors focus:outline-none focus:text-white"
            >
              About the Festival
            </a>
          </li>
          <li>
            <a
              href="/schedule"
              class="text-stone-400 hover:text-white transition-colors focus:outline-none focus:text-white"
            >
              Event Schedule
            </a>
          </li>
          <li>
            <a
              href="/submit"
              class="text-stone-400 hover:text-white transition-colors focus:outline-none focus:text-white"
            >
              Submit Your Film
            </a>
          </li>
          <li>
            <a
              href="/contact"
              class="text-stone-400 hover:text-white transition-colors focus:outline-none focus:text-white"
            >
              Contact & Press
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Contact Information -->
      <div class="md:col-span-4">
        <h4
          class="text-[10px] font-bold text-white uppercase tracking-[0.3em] mb-8"
        >
          Contact
        </h4>
        <address class="not-italic space-y-5 text-sm text-stone-500">
          <p class="flex items-start gap-4 group">
            <svg
              class="w-5 h-5 text-stone-600 shrink-0 mt-0.5 group-hover:text-stone-400 transition-colors"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
              ></path>
            </svg>
            <span>Mananthavady Municipality,<br />Wayanad, Kerala, India</span>
          </p>
          <p class="flex items-center gap-4 group">
            <svg
              class="w-5 h-5 text-stone-600 shrink-0 group-hover:text-stone-400 transition-colors"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
              ></path>
            </svg>
            <a
              href="mailto:info@drishtidosham.in"
              class="hover:text-white transition-colors"
              >info@drishtidosham.in</a
            >
          </p>
          <p class="flex items-center gap-4 group">
            <svg
              class="w-5 h-5 text-stone-600 shrink-0 group-hover:text-stone-400 transition-colors"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"
              ></path>
            </svg>
            <a
              href="tel:+911234567890"
              class="hover:text-white transition-colors">+91 12345 67890</a
            >
          </p>
        </address>
      </div>
    </div>

    <!-- Bottom Section: Copyright & Legal -->
    <div
      class="border-t border-stone-800/60 pt-8 flex flex-col md:flex-row justify-between items-center gap-6"
    >
      <p class="text-[10px] uppercase tracking-widest text-stone-600 font-bold">
        &copy; {currentYear} DrishtiDosham. All rights reserved.
      </p>
      <div
        class="flex items-center gap-6 text-[10px] uppercase tracking-widest text-stone-600 font-bold"
      >
        <a href="/privacy" class="hover:text-stone-300 transition-colors"
          >Privacy Policy</a
        >
        <a href="/terms" class="hover:text-stone-300 transition-colors"
          >Terms of Service</a
        >
      </div>
    </div>
  </div>
</footer>
