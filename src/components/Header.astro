---
// src/components/Header.astro
---

<header
  class="bg-[#FAFAFA] border-b border-stone-200 sticky top-0 z-50 antialiased selection:bg-stone-900 selection:text-white"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="flex justify-between items-center h-24">
      <!-- Brand / Logo Area -->
      <div class="flex-shrink-0 flex items-center">
        <a
          href="/"
          class="flex flex-col justify-center group focus:outline-none"
        >
          <span
            class="text-2xl sm:text-3xl font-black text-stone-900 tracking-tighter uppercase leading-none group-hover:text-stone-500 transition-colors"
          >
            Drishti<span class="text-stone-400">Dosham</span>
          </span>
          <span
            class="text-[9px] sm:text-[10px] font-bold text-stone-500 uppercase tracking-[0.3em] mt-1.5"
          >
            Short Film Festival
          </span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <ul class="hidden md:flex items-center space-x-10">
        <li>
          <a
            href="/about"
            class="text-xs font-bold uppercase tracking-widest text-stone-500 hover:text-stone-900 border-b border-transparent hover:border-stone-900 transition-all py-2"
            >About</a
          >
        </li>
        <li>
          <a
            href="/schedule"
            class="text-xs font-bold uppercase tracking-widest text-stone-500 hover:text-stone-900 border-b border-transparent hover:border-stone-900 transition-all py-2"
            >Schedule</a
          >
        </li>
        <li>
          <a
            href="/jury"
            class="text-xs font-bold uppercase tracking-widest text-stone-500 hover:text-stone-900 border-b border-transparent hover:border-stone-900 transition-all py-2"
            >Jury</a
          >
        </li>
        <li>
          <a
            href="/rules-and-regulations"
            class="text-xs font-bold uppercase tracking-widest text-stone-500 hover:text-stone-900 border-b border-transparent hover:border-stone-900 transition-all py-2"
            >Rules and Regulations</a
          >
        </li>
      </ul>

      <!-- Desktop Action Area -->
      <div class="hidden md:flex items-center space-x-6">
        <a
          href="/register"
          class="bg-stone-900 text-white text-xs font-bold uppercase tracking-widest px-6 py-3.5 rounded-sm hover:bg-stone-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-stone-900 transition-all"
        >
          Apply Now
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="md:hidden flex items-center">
        <button
          id="mobile-menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="text-stone-900 hover:text-stone-500 focus:outline-none focus:ring-2 focus:ring-stone-900 rounded-sm p-2 transition-colors"
        >
          <span class="sr-only">Open main menu</span>
          <!-- Hamburger Icon -->
          <svg
            id="icon-hamburger"
            class="h-8 w-8 block"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
          </svg>
          <!-- X Icon -->
          <svg
            id="icon-close"
            class="h-8 w-8 hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div
    id="mobile-menu"
    class="hidden md:hidden absolute top-full left-0 w-full bg-[#FAFAFA] border-b border-stone-200 shadow-2xl"
  >
    <div class="px-6 pt-6 pb-10 space-y-1">
      <a
        href="/about"
        class="block py-4 text-2xl font-serif italic text-stone-900 border-b border-stone-200 hover:text-stone-500 transition-colors"
        >About</a
      >
      <a
        href="/schedule"
        class="block py-4 text-2xl font-serif italic text-stone-900 border-b border-stone-200 hover:text-stone-500 transition-colors"
        >Schedule</a
      >
      <a
        href="/jury"
        class="block py-4 text-2xl font-serif italic text-stone-900 border-b border-stone-200 hover:text-stone-500 transition-colors"
        >Jury</a
      >
      <a
        href="/contact"
        class="block py-4 text-2xl font-serif italic text-stone-900 border-b border-stone-200 hover:text-stone-500 transition-colors"
        >Contact</a
      >

      <!-- Mobile Action Area -->
      <div class="mt-8 pt-4 flex flex-col gap-4">
        <a
          href="/register"
          class="block w-full text-center px-4 py-4 rounded-sm text-sm font-bold uppercase tracking-widest text-white bg-stone-900 hover:bg-stone-800 transition-all"
        >
          Apply Now
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const iconHamburger = document.getElementById("icon-hamburger");
  const iconClose = document.getElementById("icon-close");

  if (btn && menu && iconHamburger && iconClose) {
    btn.addEventListener("click", () => {
      menu.classList.toggle("hidden");
      const isExpanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!isExpanded));
      iconHamburger.classList.toggle("hidden");
      iconHamburger.classList.toggle("block");
      iconClose.classList.toggle("hidden");
      iconClose.classList.toggle("block");
    });
  }
</script>
