---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Jury Members & Committee | DrishtiDosham Season 03">
  <!-- HERO SECTION -->
  <section
    class="bg-[#FAFAFA] pt-24 pb-20 px-4 sm:px-6 lg:px-8 border-b border-stone-200 antialiased selection:bg-stone-900 selection:text-white relative overflow-hidden"
  >
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,#e5e5e5_1px,transparent_1px),linear-gradient(to_bottom,#e5e5e5_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-40 pointer-events-none"
    >
    </div>

    <div class="relative max-w-5xl mx-auto text-center z-10">
      <div class="mb-4 flex items-center justify-center gap-4">
        <span class="h-px w-8 bg-stone-400"></span>
        <span
          class="text-xs font-bold uppercase tracking-[0.3em] text-stone-600"
          >Season 03 Panels</span
        >
        <span class="h-px w-8 bg-stone-400"></span>
      </div>

      <h1
        class="text-5xl sm:text-7xl md:text-8xl font-black text-stone-900 tracking-tighter uppercase leading-[0.9] mb-6"
      >
        The <span class="text-stone-500">Jury</span>
      </h1>

      <p class="text-2xl md:text-4xl font-serif italic text-stone-700 mb-6">
        Curators and Evaluators
      </p>

      <p
        class="text-base md:text-lg text-stone-600 max-w-2xl mx-auto leading-relaxed"
      >
        Distinguished filmmakers, critics, and scholars overseeing the
        preliminary screening and final award selections for Season 03.
      </p>
    </div>
  </section>

  <!-- FINAL JURY SECTION -->
  <section
    class="bg-white py-24 md:py-32 px-4 sm:px-6 lg:px-8 border-b border-stone-200 antialiased"
  >
    <div class="max-w-7xl mx-auto">
      <div class="mb-16">
        <div class="mb-4 flex items-center gap-4">
          <span class="h-px w-8 bg-stone-300"></span>
          <span
            class="text-[10px] font-bold uppercase tracking-[0.3em] text-stone-500"
            >Award Decision Panel</span
          >
        </div>
        <h2
          class="text-3xl sm:text-5xl font-black text-stone-900 tracking-tighter uppercase"
        >
          Final <span class="text-stone-400">Jury</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Jury Member 1 -->
        <div
          class="bg-stone-50 border border-stone-200 p-8 rounded-sm shadow-sm flex flex-col justify-between group"
        >
          <div>
            <div
              class="relative aspect-[4/3] bg-stone-200 mb-6 overflow-hidden rounded-sm"
            >
              <img
                src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=80"
                alt="Prof. K. R. Mohanan"
                class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
                loading="lazy"
              />
            </div>
            <span
              class="text-[9px] font-bold uppercase tracking-widest text-stone-400 block mb-1"
              >Chief Curator</span
            >
            <h3 class="text-2xl font-serif italic text-stone-900 mb-2">
              Prof. K. R. Mohanan
            </h3>
            <p class="text-xs text-stone-600 leading-relaxed">
              Renowned film scholar and veteran academician heading the final
              award deliberations at Mananthavady.
            </p>
          </div>
        </div>

        <!-- Jury Member 2 -->
        <div
          class="bg-stone-50 border border-stone-200 p-8 rounded-sm shadow-sm flex flex-col justify-between group"
        >
          <div>
            <div
              class="relative aspect-[4/3] bg-stone-200 mb-6 overflow-hidden rounded-sm"
            >
              <img
                src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=600&q=80"
                alt="Dr. Anvar Sadik"
                class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
                loading="lazy"
              />
            </div>
            <span
              class="text-[9px] font-bold uppercase tracking-widest text-stone-400 block mb-1"
              >Writer & Critic</span
            >
            <h3 class="text-2xl font-serif italic text-stone-900 mb-2">
              Dr. Anvar Sadik
            </h3>
            <p class="text-xs text-stone-600 leading-relaxed">
              Prominent Malayalam cinema historian and author specializing in
              regional narrative aesthetics.
            </p>
          </div>
        </div>

        <!-- Jury Member 3 -->
        <div
          class="bg-stone-50 border border-stone-200 p-8 rounded-sm shadow-sm flex flex-col justify-between group"
        >
          <div>
            <div
              class="relative aspect-[4/3] bg-stone-200 mb-6 overflow-hidden rounded-sm"
            >
              <img
                src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=600&q=80"
                alt="Maya Menon"
                class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
                loading="lazy"
              />
            </div>
            <span
              class="text-[9px] font-bold uppercase tracking-widest text-stone-400 block mb-1"
              >Independent Filmmaker</span
            >
            <h3 class="text-2xl font-serif italic text-stone-900 mb-2">
              Maya Menon
            </h3>
            <p class="text-xs text-stone-600 leading-relaxed">
              Award-winning documentary and short-format director with extensive
              international screening experience.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRELIMINARY SCREENING COMMITTEE SECTION -->
  <section
    class="bg-[#FAFAFA] py-24 md:py-32 px-4 sm:px-6 lg:px-8 border-b border-stone-200 antialiased"
  >
    <div class="max-w-7xl mx-auto">
      <div class="mb-16">
        <div class="mb-4 flex items-center gap-4">
          <span class="h-px w-8 bg-stone-300"></span>
          <span
            class="text-[10px] font-bold uppercase tracking-[0.3em] text-stone-500"
            >Entry Evaluation Panel</span
          >
        </div>
        <h2
          class="text-3xl sm:text-5xl font-black text-stone-900 tracking-tighter uppercase"
        >
          Preliminary <span class="text-stone-400">Screening Committee</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Committee Member 1 -->
        <div
          class="bg-white border border-stone-200 p-6 rounded-sm shadow-sm group"
        >
          <span
            class="text-[9px] font-bold uppercase tracking-widest text-stone-400 block mb-1"
            >Member</span
          >
          <h3 class="text-xl font-serif italic text-stone-900 mb-1">
            Rahul K.
          </h3>
          <p class="text-xs text-stone-500 uppercase tracking-widest">
            Screenplay Reader
          </p>
        </div>

        <!-- Committee Member 2 -->
        <div
          class="bg-white border border-stone-200 p-6 rounded-sm shadow-sm group"
        >
          <span
            class="text-[9px] font-bold uppercase tracking-widest text-stone-400 block mb-1"
            >Member</span
          >
          <h3 class="text-xl font-serif italic text-stone-900 mb-1">
            Anjali Menon
          </h3>
          <p class="text-xs text-stone-500 uppercase tracking-widest">
            Technical Coordinator
          </p>
        </div>

        <!-- Committee Member 3 -->
        <div
          class="bg-white border border-stone-200 p-6 rounded-sm shadow-sm group"
        >
          <span
            class="text-[9px] font-bold uppercase tracking-widest text-stone-400 block mb-1"
            >Member</span
          >
          <h3 class="text-xl font-serif italic text-stone-900 mb-1">
            Sreejith D.
          </h3>
          <p class="text-xs text-stone-500 uppercase tracking-widest">
            Editing Analyst
          </p>
        </div>

        <!-- Committee Member 4 -->
        <div
          class="bg-white border border-stone-200 p-6 rounded-sm shadow-sm group"
        >
          <span
            class="text-[9px] font-bold uppercase tracking-widest text-stone-400 block mb-1"
            >Member</span
          >
          <h3 class="text-xl font-serif italic text-stone-900 mb-1">
            Meera S.
          </h3>
          <p class="text-xs text-stone-500 uppercase tracking-widest">
            Documentation Lead
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
