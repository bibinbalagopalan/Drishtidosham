---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Festival Timeline & Schedule | DrishtiDosham Season 03">
  <!-- HERO SECTION -->
  <section
    class="bg-[#FAFAFA] pt-24 pb-20 px-4 sm:px-6 lg:px-8 border-b border-stone-200 antialiased selection:bg-stone-900 selection:text-white relative overflow-hidden"
  >
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,#e5e5e5_1px,transparent_1px),linear-gradient(to_bottom,#e5e5e5_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-40 pointer-events-none"
    >
    </div>

    <div class="relative max-w-5xl mx-auto text-center z-10">
      <div class="mb-4 flex items-center justify-center gap-4">
        <span class="h-px w-8 bg-stone-400"></span>
        <span
          class="text-xs font-bold uppercase tracking-[0.3em] text-stone-600"
          >Season 03 Timeline</span
        >
        <span class="h-px w-8 bg-stone-400"></span>
      </div>

      <h1
        class="text-5xl sm:text-7xl md:text-8xl font-black text-stone-900 tracking-tighter uppercase leading-[0.9] mb-6"
      >
        Festival <span class="text-stone-500">Schedule</span>
      </h1>

      <p class="text-2xl md:text-4xl font-serif italic text-stone-700 mb-6">
        Mananthavady
      </p>

      <p
        class="text-base md:text-lg text-stone-600 max-w-2xl mx-auto leading-relaxed"
      >
        November 20, 2026.
      </p>
    </div>
  </section>

  <!-- PHASE 1: SUBMISSION & PRE-EVENT MILESTONES -->
  <section
    class="bg-white py-24 md:py-32 px-4 sm:px-6 lg:px-8 border-b border-stone-200 antialiased"
  >
    <div class="max-w-5xl mx-auto">
      <div class="mb-16">
        <div class="mb-4 flex items-center gap-4">
          <span class="h-px w-8 bg-stone-300"></span>
          <span
            class="text-[10px] font-bold uppercase tracking-[0.3em] text-stone-500"
            >Phase 01</span
          >
        </div>
        <h2
          class="text-3xl sm:text-4xl font-black text-stone-900 tracking-tighter uppercase"
        >
          Submissions & <span class="text-stone-400">Curatorial Phase</span>
        </h2>
      </div>

      <!-- Prominent Grid Timeline Layout -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div
          class="bg-stone-50 border border-stone-200 p-8 rounded-sm shadow-sm flex flex-col justify-between"
        >
          <div>
            <span
              class="text-[10px] font-bold uppercase tracking-[0.2em] text-stone-400 block mb-2"
              >Milestone</span
            >
            <div
              class="text-3xl sm:text-4xl font-black text-stone-900 tracking-tight mb-4 pb-4 border-b border-stone-200"
            >
              01 Sep <span
                class="text-stone-400 font-serif italic text-2xl font-normal"
                >2026</span
              >
            </div>
            <h3 class="text-xl font-serif italic text-stone-900 mb-3">
              Applications Open
            </h3>
            <p class="text-xs text-stone-600 leading-relaxed">
              Official call for entries begins across Kerala. Independent
              filmmakers can submit unlisted YouTube links or public Google
              Drive screeners via the registration portal.
            </p>
          </div>
        </div>

        <!-- Card 2 -->
        <div
          class="bg-stone-50 border border-stone-200 p-8 rounded-sm shadow-sm flex flex-col justify-between"
        >
          <div>
            <span
              class="text-[10px] font-bold uppercase tracking-[0.2em] text-stone-400 block mb-2"
              >Deadline</span
            >
            <div
              class="text-3xl sm:text-4xl font-black text-stone-900 tracking-tight mb-4 pb-4 border-b border-stone-200"
            >
              05 Nov <span
                class="text-stone-400 font-serif italic text-2xl font-normal"
                >2026</span
              >
            </div>
            <h3 class="text-xl font-serif italic text-stone-900 mb-3">
              Submission Deadline
            </h3>
            <p class="text-xs text-stone-600 leading-relaxed">
              Final cut-off for all film applications at 11:59 PM IST. Late
              submissions will not be entertained by the screening committee.
            </p>
          </div>
        </div>

        <!-- Card 3 -->
        <div
          class="bg-stone-50 border border-stone-200 p-8 rounded-sm shadow-sm flex flex-col justify-between"
        >
          <div>
            <span
              class="text-[10px] font-bold uppercase tracking-[0.2em] text-stone-400 block mb-2"
              >Announcement</span
            >
            <div
              class="text-3xl sm:text-4xl font-black text-stone-900 tracking-tight mb-4 pb-4 border-b border-stone-200"
            >
              12 Nov <span
                class="text-stone-400 font-serif italic text-2xl font-normal"
                >2026</span
              >
            </div>
            <h3 class="text-xl font-serif italic text-stone-900 mb-3">
              Official Top 10 Selection
            </h3>
            <p class="text-xs text-stone-600 leading-relaxed">
              The jury finalizes and announces the official selection of top 10
              short films competing for the final awards in Mananthavady.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PHASE 2: THE MAIN EVENT (SINGLE DAY SCHEDULE) -->
  <section
    class="bg-[#FAFAFA] py-24 md:py-32 px-4 sm:px-6 lg:px-8 border-b border-stone-200 antialiased"
  >
    <div class="max-w-5xl mx-auto">
      <!-- Big Bold Event Date Banner -->
      <div
        class="mb-20 bg-stone-950 text-white p-10 sm:p-14 rounded-sm shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-8"
      >
        <div>
          <span
            class="text-[10px] font-bold uppercase tracking-[0.3em] text-stone-400 block mb-2"
            >Phase 02 • Single Day Festival Event</span
          >
          <h2
            class="text-3xl sm:text-5xl font-black tracking-tighter uppercase mb-2"
          >
            Mananthavady Gala
          </h2>
          <p class="text-sm font-serif italic text-stone-400">
            Pazhassiraja Granthalayam & Municipality Auditorium
          </p>
        </div>
        <div
          class="bg-white/10 border border-white/20 p-6 rounded-sm text-center md:text-right w-full md:w-auto"
        >
          <span
            class="block text-[10px] font-bold uppercase tracking-widest text-stone-400 mb-1"
            >Event Date</span
          >
          <span
            class="text-3xl sm:text-4xl font-black tracking-tighter text-white"
            >20 NOV 2026</span
          >
        </div>
      </div>

      <div class="mb-12">
        <h3
          class="text-2xl font-black text-stone-900 tracking-tighter uppercase"
        >
          Detailed <span class="text-stone-400">Event Timings</span>
        </h3>
      </div>

      <!-- Timeline List for Single Day Event -->
      <div
        class="space-y-12 border-l border-stone-200 pl-6 sm:pl-10 ml-2 sm:ml-4"
      >
        <!-- Event Item 1 -->
        <div class="relative group">
          <div
            class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-stone-900 border-4 border-[#FAFAFA] shadow-sm"
          >
          </div>
          <div
            class="text-xl sm:text-2xl font-black text-stone-900 tracking-tight mb-1"
          >
            09:30 AM — 10:30 AM
          </div>
          <h4 class="text-xl font-serif italic text-stone-800 mb-2">
            Inauguration & Welcome Address
          </h4>
          <p class="text-sm text-stone-600 max-w-2xl leading-relaxed">
            Official lamp lighting by Mananthavady Municipality dignitaries
            followed by the festival keynote address and introduction of the
            jury panel.
          </p>
        </div>

        <!-- Event Item 2 -->
        <div class="relative group">
          <div
            class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-stone-900 border-4 border-[#FAFAFA] shadow-sm"
          >
          </div>
          <div
            class="text-xl sm:text-2xl font-black text-stone-900 tracking-tight mb-1"
          >
            10:30 AM — 01:30 PM
          </div>
          <h4 class="text-xl font-serif italic text-stone-800 mb-2">
            Morning Screening Block (Films 1 to 5)
          </h4>
          <p class="text-sm text-stone-600 max-w-2xl leading-relaxed">
            Public and jury screening of the first half of the official top 10
            short film selections, accompanied by brief filmmaker interactions.
          </p>
        </div>

        <!-- Event Item 3 -->
        <div class="relative group">
          <div
            class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-stone-300 border-4 border-[#FAFAFA] shadow-sm"
          >
          </div>
          <div
            class="text-xl sm:text-2xl font-black text-stone-900 tracking-tight mb-1"
          >
            01:30 PM — 02:30 PM
          </div>
          <h4 class="text-xl font-serif italic text-stone-800 mb-2">
            Networking Lunch Break
          </h4>
          <p class="text-sm text-stone-600 max-w-2xl leading-relaxed">
            An open gathering for independent directors, actors, media
            personnel, and film enthusiasts at the venue courtyard.
          </p>
        </div>

        <!-- Event Item 4 -->
        <div class="relative group">
          <div
            class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-stone-900 border-4 border-[#FAFAFA] shadow-sm"
          >
          </div>
          <div
            class="text-xl sm:text-2xl font-black text-stone-900 tracking-tight mb-1"
          >
            02:30 PM — 05:30 PM
          </div>
          <h4 class="text-xl font-serif italic text-stone-800 mb-2">
            Evening Screening Block (Films 6 to 10)
          </h4>
          <p class="text-sm text-stone-600 max-w-2xl leading-relaxed">
            Screening of the remaining official selections followed by an
            open-floor interactive Q&A session with the attending directors.
          </p>
        </div>

        <!-- Event Item 5 -->
        <div class="relative group">
          <div
            class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-stone-900 border-4 border-[#FAFAFA] shadow-sm"
          >
          </div>
          <div
            class="text-xl sm:text-2xl font-black text-stone-900 tracking-tight mb-1"
          >
            06:00 PM — 08:00 PM
          </div>
          <h4 class="text-xl font-serif italic text-stone-800 mb-2">
            Award Ceremony & Closing Gala
          </h4>
          <p class="text-sm text-stone-600 max-w-2xl leading-relaxed">
            The grand finale event. Announcement of winners for Best Short Film,
            Best Director, Technical Laureates, and closing remarks by
            Pazhassiraja Granthalayam representatives.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
