---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Rules & Regulations | DrishtiDosham Season 03">
  <!-- HERO SECTION -->
  <section
    class="bg-[#FAFAFA] pt-24 pb-20 px-4 sm:px-6 lg:px-8 border-b border-stone-200 antialiased selection:bg-stone-900 selection:text-white relative overflow-hidden"
  >
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,#e5e5e5_1px,transparent_1px),linear-gradient(to_bottom,#e5e5e5_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-40 pointer-events-none"
    >
    </div>

    <div class="relative max-w-5xl mx-auto text-center z-10">
      <div class="mb-4 flex items-center justify-center gap-4">
        <span class="h-px w-8 bg-stone-400"></span>
        <span
          class="text-xs font-bold uppercase tracking-[0.3em] text-stone-600"
          >Season 03 Guidelines</span
        >
        <span class="h-px w-8 bg-stone-400"></span>
      </div>

      <h1
        class="text-5xl sm:text-7xl md:text-8xl font-black text-stone-900 tracking-tighter uppercase leading-[0.9] mb-6"
      >
        Rules & <span class="text-stone-500">Regulations</span>
      </h1>

      <p class="text-2xl md:text-4xl font-serif italic text-stone-700 mb-6">
        Official Festival Terms
      </p>

      <p
        class="text-base md:text-lg text-stone-600 max-w-2xl mx-auto leading-relaxed"
      >
        Please review the eligibility criteria, technical specifications, and
        submission guidelines before entering your film into DrishtiDosham
        Season 03.
      </p>
    </div>
  </section>

  <!-- RULES CONTENT SECTION -->
  <section
    class="bg-white py-24 md:py-32 px-4 sm:px-6 lg:px-8 border-b border-stone-200 antialiased"
  >
    <div class="max-w-4xl mx-auto space-y-16">
      <!-- Rule Item 1 -->
      <div class="border-b border-stone-200 pb-12">
        <div class="mb-3 flex items-center gap-4">
          <span
            class="text-[10px] font-bold uppercase tracking-[0.3em] text-stone-400"
            >Section 01</span
          >
        </div>
        <h2 class="text-2xl sm:text-3xl font-serif italic text-stone-900 mb-4">
          Eligibility & Runtime
        </h2>
        <p class="text-sm sm:text-base text-stone-600 leading-relaxed mb-4">
          Submissions are open to all independent filmmakers worldwide, with a
          special emphasis on regional narrative traditions. The maximum runtime
          for short film entries must not exceed 30 minutes, including opening
          and closing credits.
        </p>
        <p class="text-xs text-stone-500 uppercase tracking-widest font-bold">
          • Max Runtime: 30 Minutes • Open to All Formats (Fiction, Non-Fiction,
          Animation)
        </p>
      </div>

      <!-- Rule Item 2 -->
      <div class="border-b border-stone-200 pb-12">
        <div class="mb-3 flex items-center gap-4">
          <span
            class="text-[10px] font-bold uppercase tracking-[0.3em] text-stone-400"
            >Section 02</span
          >
        </div>
        <h2 class="text-2xl sm:text-3xl font-serif italic text-stone-900 mb-4">
          Screener Link Guidelines
        </h2>
        <p class="text-sm sm:text-base text-stone-600 leading-relaxed mb-4">
          We accept two formats for online jury evaluation: unlisted YouTube
          links or public Google Drive links set to "View for all" access.
          Filmmakers must ensure the link remains active and accessible through
          November 20, 2026.
        </p>
        <p class="text-xs text-stone-500 uppercase tracking-widest font-bold">
          • Accepted: Unlisted YouTube / Public Google Drive • No physical media
          submissions required.
        </p>
      </div>

      <!-- Rule Item 3 -->
      <div class="border-b border-stone-200 pb-12">
        <div class="mb-3 flex items-center gap-4">
          <span
            class="text-[10px] font-bold uppercase tracking-[0.3em] text-stone-400"
            >Section 03</span
          >
        </div>
        <h2 class="text-2xl sm:text-3xl font-serif italic text-stone-900 mb-4">
          Subtitles & Language
        </h2>
        <p class="text-sm sm:text-base text-stone-600 leading-relaxed mb-4">
          Films in languages other than Malayalam or English must include
          embedded or hardcoded English subtitles. Failure to provide legible
          English subtitles will result in immediate disqualification by the
          preliminary screening committee.
        </p>
        <p class="text-xs text-stone-500 uppercase tracking-widest font-bold">
          • Mandatory English Subtitles for non-English/non-Malayalam dialogues.
        </p>
      </div>

      <!-- Rule Item 4 -->
      <div class="border-b border-stone-200 pb-12">
        <div class="mb-3 flex items-center gap-4">
          <span
            class="text-[10px] font-bold uppercase tracking-[0.3em] text-stone-400"
            >Section 04</span
          >
        </div>
        <h2 class="text-2xl sm:text-3xl font-serif italic text-stone-900 mb-4">
          Copyright & Rights
        </h2>
        <p class="text-sm sm:text-base text-stone-600 leading-relaxed mb-4">
          The applicant must hold all legal rights to the submitted material,
          including original score/soundtracks and visual footage. DrishtiDosham
          Film Festival holds no liability for copyright infringements by
          participating filmmakers.
        </p>
        <p class="text-xs text-stone-500 uppercase tracking-widest font-bold">
          • Applicant guarantees full clearance of all intellectual property
          rights.
        </p>
      </div>

      <!-- Rule Item 5 -->
      <div class="pb-4">
        <div class="mb-3 flex items-center gap-4">
          <span
            class="text-[10px] font-bold uppercase tracking-[0.3em] text-stone-400"
            >Section 05</span
          >
        </div>
        <h2 class="text-2xl sm:text-3xl font-serif italic text-stone-900 mb-4">
          Entry Fees & Refunds
        </h2>
        <p class="text-sm sm:text-base text-stone-600 leading-relaxed mb-4">
          A standard non-refundable processing fee of ₹750 applies to each
          entry. Once an application is successfully processed through the
          payment gateway, no refund requests will be entertained under any
          circumstances.
        </p>
        <p class="text-xs text-stone-500 uppercase tracking-widest font-bold">
          • Non-refundable standard entry fee: ₹750 per submission.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
